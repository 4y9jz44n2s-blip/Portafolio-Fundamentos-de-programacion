        "### 1. Pseudocódigo\n",
        "\n",
        "```text\n",
        "Algoritmo AcumuladorPiezas\n",
        "    Definir total_piezas, lote_piezas Como Entero\n",
        "    total_piezas <- 0\n",
        "    \n",
        "    Mientras total_piezas < 100 Hacer\n",
        "        Escribir \"Ingrese la cantidad de piezas creadas en este lote:\"\n",
        "        Leer lote_piezas\n",
        "        total_piezas <- total_piezas + lote_piezas\n",
        "        Escribir \"Total acumulado actualmente: \", total_piezas\n",
        "    FinMientras\n",
        "    \n",
        "    Escribir \"¡Felicidades! Se ha alcanzado o superado la meta de 100 piezas.\"\n",
        "FinAlgoritmo\n",
        "```"
      ]
    },
