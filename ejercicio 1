        "# 3. Programa en Python\n",
        "\n",
        "def control_produccion():\n",
        "    # 1. Iniciar el total de piezas en 0\n",
        "    total_piezas = 0\n",
        "    meta = 100\n",
        "\n",
        "    print(f\"--- Control de Producción (Meta: {meta} piezas) ---\")\n",
        "\n",
        "    # 4. Repetir el proceso mientras el total sea menor de 100\n",
        "    while total_piezas < meta:\n",
        "        try:\n",
        "            # 2. Solicitar el total de piezas del siguiente lote\n",
        "            lote = int(input(\"Ingrese la cantidad de piezas creadas en este lote: \"))\n",
        "            if lote < 0:\n",
        "                print(\"Por favor, ingrese un número positivo.\")\n",
        "                continue\n",
        "\n",
        "            # 3. Sumar ese total\n",
        "            total_piezas += lote\n",
        "            print(f\"Progreso: {total_piezas} / {meta} piezas.\\n\")\n",
        "        except ValueError:\n",
        "            print(\"Entrada no válida. Por favor, introduzca un número entero.\")\n",
        "\n",
        "    # 5. Mostrar el mensaje cuando se alcance la meta\n",
        "    print(\"\\n===================================================\")\n",
        "    print(f\"¡Meta alcanzada! Se han acumulado un total de {total_piezas} piezas.\")\n",
        "    print(\"===================================================\")\n",
        "\n",
        "# Ejecutar el programa\n",
        "control_produccion()"
